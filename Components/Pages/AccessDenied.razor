@page "/access-denied"

<PageTitle>Brak dostępu</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card">
                <div class="card-body">
                    <h1 class="display-1 text-danger">403</h1>
                    <h2 class="mb-4">Brak dostępu</h2>
                    <p class="lead">Nie masz uprawnień do dostępu do tej strony.</p>
                    <p>Skontaktuj się z administratorem, jeśli uważasz, że jest to błąd.</p>
                    <a href="/" class="btn btn-primary mt-3">Przejdź do strony głównej</a>
                </div>
            </div>
        </div>
    </div>
</div>


