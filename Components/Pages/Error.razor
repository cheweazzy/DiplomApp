@page "/Error"
@using System.Diagnostics

<PageTitle>Błąd</PageTitle>

<h1 class="text-danger">Błąd.</h1>
<h2 class="text-danger">Wystąpił błąd podczas przetwarzania Twojego żądania.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID żądania:</strong> <code>@RequestId</code>
    </p>
}

<h3>Tryb rozwoju</h3>
<p>
    Przełączenie do środowiska <strong>Rozwoju</strong> wyświetli więcej szczegółów o błędzie, który wystąpił.
</p>
<p>
    <strong>Środowisko Rozwoju nie powinno być włączone dla wdrożonych aplikacji.</strong>
    Może to doprowadzić do wyświetlania poufnych informacji z wyjątków dla użytkowników końcowych.
    Aby debugować lokalnie, włącz środowisko <strong>Rozwoju</strong> ustawiając zmienną środowiskową <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Rozwój</strong>
    i ponownie uruchom aplikację.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
